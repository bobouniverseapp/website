{
  "schema_version": 1,
  "configuration_name": "bobo-universe-global-banner",
  "configuration_revision": 3,
  "stage": "pre-integration",
  "control_url": "https://bobouniverseapp.github.io/website/global-banner/config-v1.json",
  "refresh_after_seconds": 3600,
  "rotation": {
    "interval_seconds": 8,
    "transition_ms": 450,
    "skip_identical_slots": true
  },
  "badge": {
    "label": "NEW",
    "always_on": true,
    "placement": "top_left",
    "animation": "soft_blink",
    "period_ms": 1800,
    "applies_to": "global_banner_only"
  },
  "slots": [
    {
      "id": "slot_1",
      "type": "bobo_universe",
      "image_url": "https://bobouniverseapp.github.io/website/assets/banners/bobo-universe-global.png",
      "asset_ready": true,
      "target_url": "https://bobouniverseapp.github.io/website/",
      "alt_text": "Bobo Universe — Discover more product with us"
    },
    {
      "id": "slot_2",
      "type": "product_promotion",
      "product_id": "bobostop",
      "image_url": "https://bobouniverseapp.github.io/website/assets/banners/bobostop-banner.png",
      "asset_ready": true,
      "target_url": "https://bobouniverseapp.github.io/website/products/bobostop/",
      "alt_text": "Discover BoboStop"
    }
  ],
  "allowed_link_hosts": [
    "bobouniverseapp.github.io",
    "play.google.com"
  ],
  "client_fallback": {
    "type": "bobo_universe",
    "target_url": "https://bobouniverseapp.github.io/website/"
  },
  "notes": "Global V1 policy: Slot 1 always Bobo Universe. Slot 2 currently promotes BoboStop. Every client must provide its own stable client_app_id; when it equals the Slot 2 product_id, render Slot 1 (Bobo Universe) in both effective slots and suppress redundant rotation. Promotion selection stays centrally managed; no per-product remote manifest. NEW soft blink applies to the Bobo Universe banner. Never use public JSON for secrets.",
  "self_promotion_policy": {
    "enabled": true,
    "app_identity_key": "client_app_id",
    "compare_slot": "slot_2",
    "promotion_product_field": "product_id",
    "on_match": "replace_slot_2_with_slot_1",
    "suppress_rotation_when_effective_slots_identical": true
  }
}
