{
  "schema_version": 1,
  "configuration_name": "bobo-universe-global-banner",
  "configuration_revision": 2,
  "stage": "pre-integration",
  "control_url": "https://bobouniverseapp.github.io/website/global-banner/config-v1.json",
  "refresh_after_seconds": 3600,
  "rotation": {
    "interval_seconds": 8,
    "transition_ms": 450,
    "skip_identical_slots": true
  },
  "badge": {
    "label": "NEW",
    "always_on": true,
    "placement": "top_left",
    "animation": "soft_blink",
    "period_ms": 1800,
    "applies_to": "global_banner_only"
  },
  "slots": [
    {
      "id": "slot_1",
      "type": "bobo_universe",
      "image_url": "https://bobouniverseapp.github.io/website/assets/banners/bobo-universe-global.png",
      "asset_ready": true,
      "target_url": "https://bobouniverseapp.github.io/website/",
      "alt_text": "Bobo Universe — Discover more product with us"
    },
    {
      "id": "slot_2",
      "type": "product_promotion",
      "product_id": "bobostop",
      "image_url": "https://bobouniverseapp.github.io/website/assets/banners/bobostop-banner.png",
      "asset_ready": true,
      "target_url": "https://bobouniverseapp.github.io/website/products/bobostop/",
      "alt_text": "Discover BoboStop"
    }
  ],
  "allowed_link_hosts": [
    "bobouniverseapp.github.io",
    "play.google.com"
  ],
  "client_fallback": {
    "type": "bobo_universe",
    "target_url": "https://bobouniverseapp.github.io/website/"
  },
  "notes": "Initial test promotion. Slot 2 is BoboStop and can be replaced by editing this manifest only. Badge animation should be native where practical and applies to the Bobo Universe banner only. Do not use this remote JSON for security-sensitive settings."
}
